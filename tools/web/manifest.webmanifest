{
	"name": "Gustfire",
	"short_name": "Gustfire",
	"description": "Artilharia por turnos em pixel art.",
	"start_url": "./",
	"scope": "./",
	"display": "fullscreen",
	"display_override": ["fullscreen", "standalone"],
	"orientation": "landscape",
	"background_color": "#000000",
	"theme_color": "#000000",
	"icons": [
		{ "src": "index.icon.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
		{ "src": "index.apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
	]
}
