# Copy to .env and change the secrets before running docker compose.
DB_PASSWORD=troque-esta-senha
# Shared by the API and the game servers (internal API). At least 16 characters.
INTERNAL_KEY=troque-esta-chave-interna-longa
# Address the players' game uses to reach the game server (the API lists it).
GAME_PUBLIC_URL=ws://localhost:7350
GAME_NAME=S1 · Nova Era
# 1 = the test coupons (TESTARTUDO, MOEDAS...) work. Only for closed tests.
TEST_COUPONS=0
# Seconds a room searches for human rivals before AI rivals fill in.
BOT_FILL_SECONDS=20
# Origin allowed to call the API from the browser (web build).
ALLOW_ORIGIN=*
# Version of the Terms of Use and Privacy Policy (legal/*.md, Legal.VERSION in the game).
# Changing it makes every player accept the texts again before playing online.
LEGAL_VERSION=2026-09-25
# How long the logs are kept (Privacy Policy): activity log, chat lines in it, and the
# access records (IP, date and time) the Marco Civil da Internet requires for 6 months.
AUDIT_RETENTION_DAYS=365
CHAT_RETENTION_DAYS=90
ACCESS_LOG_DAYS=183
# Chat reports: reviewed reports are kept this long; REPORT_MUTE different players
# reporting someone within 10 minutes mute them for 10 minutes (the team reviews later
# with tools/moderate.py).
REPORT_RETENTION_DAYS=180
REPORT_MUTE=3
# Steam (docs/STEAM.md). STEAM_WEB_API_KEY is the publisher Web API key (Steamworks →
# Users & Permissions → Manage Web API Key); never put it in the game. Keep
# STEAM_MICROTXN_SANDBOX=1 until the shop is approved by Valve: purchases then go to the
# sandbox and nobody is charged. STEAM_IDENTITY must match SteamService.TICKET_IDENTITY.
STEAM_APP_ID=0
STEAM_WEB_API_KEY=
STEAM_IDENTITY=frontiertank
STEAM_MICROTXN_SANDBOX=1
# Steam purchase records are kept 5 years (tax and consumer protection).
ORDER_RETENTION_DAYS=1826
