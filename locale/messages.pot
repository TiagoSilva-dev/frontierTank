#: shared/balance/tutorial.json:steps[0].name
msgid "BEM-VINDO AO TREINO"
msgstr ""

#: shared/balance/tutorial.json:steps[0].text
msgid "Em poucos minutos você aprende o essencial da artilharia. Seu alvo é o Boneco de Treino, na ilha da frente: ele não revida."
msgstr ""

#: shared/balance/tutorial.json:steps[1].text
msgid "Use ← → (ou A e D) para andar. Andar gasta ENERGIA, a barra verde embaixo à direita. Dê alguns passos."
msgstr ""

#: shared/balance/tutorial.json:steps[1].text_touch
msgid "Segure ◀ ▶ (embaixo, à esquerda) para andar. Andar gasta ENERGIA, a barra verde no alto, ao lado do retrato. Dê alguns passos."
msgstr ""

#: shared/balance/tutorial.json:steps[2].name
msgid "MIRAR"
msgstr ""

#: shared/balance/tutorial.json:steps[2].text
msgid "Use ↑ ↓ (ou W e S) para erguer ou baixar o canhão. O mostrador no canto esquerdo marca o ângulo em graus."
msgstr ""

#: shared/balance/tutorial.json:steps[2].text_touch
msgid "Segure ↑ ↓ (embaixo, à direita) para erguer ou baixar o canhão. O mostrador no canto esquerdo marca o ângulo em graus."
msgstr ""

#: shared/balance/tutorial.json:steps[3].name
msgid "VENTO"
msgstr ""

#: shared/balance/tutorial.json:steps[3].text
msgid "O vento empurra o tiro para o lado. As setas no alto mostram a direção e a força: com vento a favor o tiro vai mais longe, contra ele fica mais curto."
msgstr ""

#: shared/balance/tutorial.json:steps[4].name
msgid "DISPARAR"
msgstr ""

#: shared/balance/tutorial.json:steps[4].text
msgid "Segure ESPAÇO para encher a barra de FORÇA e solte para atirar. Mire no boneco: perto de 50% de força costuma servir. Acerte-o uma vez."
msgstr ""

#: shared/balance/tutorial.json:steps[4].text_touch
msgid "Segure FOGO para encher a barra de FORÇA e solte para atirar. Mire no boneco: perto de 50% de força costuma servir. Acerte-o uma vez."
msgstr ""

#: shared/balance/tutorial.json:steps[5].name
msgid "HABILIDADES"
msgstr ""

#: shared/balance/tutorial.json:steps[5].text
msgid "As teclas 1 a 9 dão vantagens no turno e gastam energia. Aperte 1 (+2 ataques) e dispare: saem três tiros em sequência."
msgstr ""

#: shared/balance/tutorial.json:steps[5].text_touch
msgid "As habilidades dão vantagens no turno e gastam energia. Toque em HAB., depois em 1 (+2 ataques) e segure FOGO: saem três tiros em sequência."
msgstr ""

#: shared/balance/tutorial.json:steps[6].text
msgid "A barra POW enche quando você causa e recebe dano. A sua está cheia! Aperte B e dispare para soltar o especial da sua arma."
msgstr ""

#: shared/balance/tutorial.json:steps[6].text_touch
msgid "A barra POW enche quando você causa e recebe dano. A sua está cheia! Toque no POW, no canto inferior direito, e dispare para soltar o especial da sua arma."
msgstr ""

#: shared/balance/tutorial.json:steps[7].name
msgid "DERRUBE O BONECO"
msgstr ""

#: shared/balance/tutorial.json:steps[7].text
msgid "Use tudo o que aprendeu e derrube o Boneco de Treino. Agora ele não se recompõe!"
msgstr ""
